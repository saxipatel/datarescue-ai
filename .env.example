# Copied to .env by `make setup`. Values are local development defaults.
# docker-compose.yml sets DATABASE_URL, REDIS_URL and DATA_DIR for the containers.

ENVIRONMENT=development
LOG_LEVEL=INFO

# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-0000
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Allows `chaos_crash_after` on POST /recoveries (failure-injection demos). Keep false
# anywhere that is not a local sandbox.
CHAOS_ENABLED=true

FRESHNESS_CHECK_INTERVAL_SECONDS=300
STALE_JOB_TIMEOUT_SECONDS=300
RATE_LIMIT_PER_MINUTE=20
INGESTION_CHUNK_SIZE=1000
MAX_UPLOAD_BYTES=52428800

# Optional LLM enrichment of diagnoses. The platform works without it; the
# deterministic diagnosis always runs. Requires `pip install '.[llm]'` in the image.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
